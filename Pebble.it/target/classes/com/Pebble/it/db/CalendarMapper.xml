
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Pebble.it.db.CalendarMapper">
	<resultMap id="CalenderMap" type="com.Pebble.it.model.CalendarDTO">
    <id property="CAL_IDX" column="CAL_IDX" />
    <result property="USER_ID" column="USER_ID" />
    <result property="CAL_TITLE" column="CAL_TITLE" />
    <result property="CAL_CONTENT" column="CAL_CONTENT" />
    <result property="CAL_ST_DT" column="CAL_ST_DT" />
    <result property="CAL_ED_DT" column="CAL_ED_DT" />
    <result property="CAL_COLOR" column="CAL_COLOR" />
    <result property="CAL_STATUS" column="CAL_STATUS" />
  </resultMap>
	
	<!-- 일정 등록 -->
    <insert id="insertCalendar" parameterType="com.Pebble.it.model.CalendarDTO">
        INSERT INTO TB_CALENDAR (
            USER_ID, CAL_TITLE, CAL_CONTENT, CAL_ST_DT, CAL_ED_DT, CAL_COLOR, CAL_STATUS
        ) VALUES (
            #{USER_ID}, #{CAL_TITLE}, #{CAL_CONTENT}, #{CAL_ST_DT}, #{CAL_ED_DT}, #{CAL_COLOR}, #{CAL_STATUS}
        )
    </insert>

    <!-- 일정 조회 -->
    <select id="getCalendars" resultType="com.Pebble.it.model.CalendarDTO">
        SELECT * FROM TB_CALENDAR WHERE USER_ID = #{USER_ID}
    </select>
	
</mapper>